<?xml version="1.0" encoding="utf-8"?>
<!--
    Security: the Rust core's pairing identity (identity.json) and trusted-peer
    store (known_peers.json) must never leave the device. Restoring them onto
    another device would clone this device's pairing identity, enabling silent
    impersonation toward previously trusted peers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="identity.json" />
        <exclude domain="external" path="known_peers.json" />
        <exclude domain="file" path="identity.json" />
        <exclude domain="file" path="known_peers.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="identity.json" />
        <exclude domain="external" path="known_peers.json" />
        <exclude domain="file" path="identity.json" />
        <exclude domain="file" path="known_peers.json" />
    </device-transfer>
</data-extraction-rules>
